{
  "model": "DeepSeek V4 Flash",
  "request_model": "deepseek-v4-flash",
  "url": "{{BASE_URL}}/v1/chat/completions",
  "method": "POST",
  "headers": {
    "Authorization": "Bearer {{API_KEY}}",
    "Content-Type": "application/json",
    "User-Agent": "sakrylle-status/1.0"
  },
  "body": {
    "model": "{{MODEL}}",
    "max_tokens": 32,
    "stream": false,
    "messages": [
      {"role": "user", "content": "{{PROMPT}}"}
    ]
  },
  "response": {
    "success_contains": "{{EXPECTED_ANSWER}}"
  },
  "probe": {
    "slow_latency": "8s",
    "timeout": "30s",
    "retry": 0
  }
}
