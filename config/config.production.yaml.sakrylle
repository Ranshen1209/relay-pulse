# Sakrylle Status 生产配置：每个监测 key 只绑定一个 Sub2API group。
# 可用率按重试后的探测成功率统计：正常/缓慢均计 1，失败计 0；
# 前端按实际探测次数汇总，完全无数据的时间块不参与计算。
# 响应与答案校验通过后，耗时 <= 15s 为正常，> 15s 为缓慢。
# 每轮最多 4 次尝试，共享 30s 超时预算，只保存最终结果。
# GPT-Image、GPT-Team、Claude 和 DeepSeek 通道保持下架。
#
interval: 3m
slow_latency: 15s
degraded_weight: 1.0

public_base_url: https://status.sakrylle.com

storage:
  type: sqlite
  sqlite:
    path: /data/monitor.db

monitors:
  # Group 3 - GPT-Pro-Special @ 0.28x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro-special
    channel_name: GPT-Pro-Special
    model: GPT 5.5
    request_model: gpt-5.5
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    slow_latency: 15s
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_SPECIAL_API_KEY

  # Group 14 - GPT-Pro @ 0.40x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro
    channel_name: GPT-Pro
    model: GPT 5.5
    request_model: gpt-5.5
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    slow_latency: 15s
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_API_KEY

  # Group 35 - GPT-Plus @ 0.18x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-plus
    channel_name: GPT-Plus
    model: GPT 5.5
    request_model: gpt-5.5
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    slow_latency: 15s
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PLUS_API_KEY

  # Group 41 - Grok-Build @ 0.40x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: gk
    service_name: Grok
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: grok-build
    channel_name: Grok-Build
    model: Grok 4.6
    request_model: grok-4.6
    base_url: https://api.sakrylle.com
    template: gk-grok-arith
    slow_latency: 15s
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GROK_BUILD_API_KEY
