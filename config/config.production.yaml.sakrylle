# Sakrylle Status - Production config
#
# Probes the selected active token-billed Sakrylle groups. GPT-Image (5),
# Claude-Max (16), Claude-Max-C (17), and GPT-Team (36) are intentionally not
# monitored. API keys are injected via env vars and each key is scoped to
# exactly one Sub2API group.
#
# GPT probes use gpt-5.6-terra, which was verified through the gateway with
# successful responses and usage records. GPT-Image is intentionally not
# monitored; its existing key remains outside this configuration. GPT-Team's
# existing key is also retained outside this configuration.
#
interval: 3m
slow_latency: 8s

public_base_url: https://status.sakrylle.com

storage:
  type: sqlite
  sqlite:
    path: /data/monitor.db

monitors:
  # Group 2 - Claude-AWSQ @ 0.30x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cc
    service_name: Claude
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: claude-awsq
    channel_name: Claude-AWSQ
    base_url: https://api.sakrylle.com
    template: cc-haiku-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_CLAUDE_AWSQ_API_KEY

  # Group 3 - GPT-Pro-Special @ 0.30x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro-special
    channel_name: GPT-Pro-Special
    model: GPT 5.6 Terra
    request_model: gpt-5.6-terra
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_SPECIAL_API_KEY

  # Group 9 - DeepSeek-Anthropic @ 1.00x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: dx
    service_name: DeepSeek
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: deepseek-official
    channel_name: DeepSeek-Anthropic
    base_url: https://api.sakrylle.com
    template: dx-flash-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_DEEPSEEK_OFFICIAL_API_KEY

  # Group 14 - GPT-Pro @ 0.35x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro
    channel_name: GPT-Pro
    model: GPT 5.6 Terra
    request_model: gpt-5.6-terra
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_API_KEY

  # Group 15 - Claude-Kiro @ 0.30x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cc
    service_name: Claude
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: claude-kiro
    channel_name: Claude-Kiro
    base_url: https://api.sakrylle.com
    template: cc-haiku-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_CLAUDE_KIRO_API_KEY

  # Group 22 - Grok-API @ 0.10x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: gk
    service_name: Grok
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: grok
    channel_name: Grok-API
    base_url: https://api.sakrylle.com
    template: gk-grok-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GROK_API_KEY

  # Group 31 - Deepseek-OpenAI @ 1.00x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: dx
    service_name: DeepSeek
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: deepseek-openai
    channel_name: DeepSeek-OpenAI
    base_url: https://api.sakrylle.com
    # This route spends the first 8 tokens on reasoning; give it 32 so the
    # semantic answer is present instead of treating a valid 200 as a miss.
    template: dx-flash-openai-chat-extended
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_DEEPSEEK_OPENAI_API_KEY

  # Group 33 - DeepSeek-Plan-Anthropic @ 0.60x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: dx
    service_name: DeepSeek
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: deepseek-plan-anthropic
    channel_name: DeepSeek-Plan-Anthropic
    base_url: https://api.sakrylle.com
    template: dx-flash-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_DEEPSEEK_PLAN_ANTHROPIC_API_KEY

  # Group 34 - DeepSeek-Plan-OpenAI @ 0.60x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: dx
    service_name: DeepSeek
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: deepseek-plan-openai
    channel_name: DeepSeek-Plan-OpenAI
    base_url: https://api.sakrylle.com
    template: dx-flash-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_DEEPSEEK_PLAN_OPENAI_API_KEY

  # Group 35 - GPT-Plus @ 0.20x
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-plus
    channel_name: GPT-Plus
    model: GPT 5.6 Terra
    request_model: gpt-5.6-terra
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PLUS_API_KEY
