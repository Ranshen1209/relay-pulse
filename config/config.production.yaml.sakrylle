# Sakrylle Status — Production config
#
# Probes Sakrylle API on behalf of users; public links point to ai1.sakrylle.com.
# 3 monitor definitions were observed in production on
# 2026-08-16. The GPT template still requests gpt-5.4-mini; that model was
# absent from /v1/models and recent probes returned 503. gpt-5.4 is visible for
# both keys, but it needs one authorized real request plus usage-log confirmation
# before this repository or production is changed. Until then, the GPT model is
# a known-stale configuration item, not a verified migration target.
# Excludes all Claude groups and the 3 image groups: GPT-Image (5),
# GPT-Image-2-4K (11), and GPT-Image-2-Async (21).
#
# API keys are injected via env vars; see env_var_name on each monitor.
# All keys are scoped to one Sakrylle group each (api_keys.group_id is
# single-valued in sub2api), so we need 1 key per group. Current verified
# bindings are GPT-Pro id 14, GPT-Pro-Special id 3, and Deepseek-Anthropic
# id 9; channel key names remain relay-pulse-gpt-pro, relay-pulse-gpt-pro-
# special, and relay-pulse-deepseek-official.
#
interval: 3m          # default cadence — every monitor below inherits this
slow_latency: 8s

# Public-facing origin — used by the SSR meta layer to build
# og:url, og:image, canonical, hreflang. Keep this explicit; the upstream
# default is not a Sakrylle production URL.
public_base_url: https://status.sakrylle.com

storage:
  type: sqlite
  sqlite:
    path: /data/monitor.db

monitors:
  # --- GPT-Pro: configured gpt-5.4-mini; group id 14, rate 0.35 ---
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro
    channel_name: GPT-Pro
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_API_KEY

  # --- GPT-Pro-Special: group id 3, rate 0.30 ---
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro-special
    channel_name: GPT-Pro-Special
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_SPECIAL_API_KEY

  # --- DeepSeek: group id 9 is currently named Deepseek-Anthropic;
  #     the probe intentionally uses the OpenAI-compatible endpoint @ 1.0x ---
  - provider: sakrylle
    provider_name: Sakrylle
    provider_url: https://ai1.sakrylle.com
    service: dx
    service_name: DeepSeek
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://ai1.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: deepseek-official
    channel_name: DeepSeek
    base_url: https://api.sakrylle.com
    template: dx-flash-openai-chat
    retry: 3
    timeout: 30s
    env_var_name: MONITOR_SAKRYLLE_DEEPSEEK_OFFICIAL_API_KEY
