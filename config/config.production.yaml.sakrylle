# Sakrylle Status — Production config
#
# Probes Sakrylle API (sub.sakrylle.com) on behalf of users.
# 4 monitors mirror the 4 live groups in sub2api: Claude-Kiro, GPT-Pro,
# GPT-Plus (discount), GPT-Image (per-request).
#
# API keys are injected via env vars; see env_var_name on each monitor.
# All keys are scoped to one Sakrylle group each (api_keys.group_id is
# single-valued in sub2api), so we need 4 separate keys.

interval: 30m         # default cadence — overridden per-monitor when needed
slow_latency: 8s

# Public-facing origin — used by the SSR meta layer to build
# og:url, og:image, canonical, hreflang. Without this it falls back
# to upstream's https://relaypulse.top and social previews show the
# wrong site.
public_base_url: https://status.sakrylle.com

storage:
  type: sqlite
  sqlite:
    path: /data/monitor.db

monitors:
  # --- Claude-Kiro: claude-haiku-4-5 cheap probe, 30m cadence ---
  - provider: sakrylle
    provider_name: Sakrylle API
    provider_url: https://sub.sakrylle.com
    service: cc
    service_name: Claude
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://sub.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: claude-kiro
    channel_name: Claude-Kiro
    base_url: https://api.sakrylle.com
    template: cc-haiku-arith
    env_var_name: MONITOR_SAKRYLLE_CLAUDE_KIRO_API_KEY

  # --- GPT-Pro: gpt-5.4-mini cheap probe, 30m cadence ---
  - provider: sakrylle
    provider_name: Sakrylle API
    provider_url: https://sub.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://sub.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-pro
    channel_name: GPT-Pro
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    env_var_name: MONITOR_SAKRYLLE_GPT_PRO_API_KEY

  # --- GPT-Plus: same upstream as GPT-Pro at deeper discount, 30m cadence ---
  - provider: sakrylle
    provider_name: Sakrylle API
    provider_url: https://sub.sakrylle.com
    service: cx
    service_name: GPT
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://sub.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-plus
    channel_name: GPT-Plus
    base_url: https://api.sakrylle.com
    template: cx-gpt-mini-chat
    env_var_name: MONITOR_SAKRYLLE_GPT_PLUS_API_KEY

  # --- GPT-Image: 90m auth-only ping (no $0.15/probe charge) ---
  # /v1/models requires an authenticated key — confirms group is reachable
  # AND that gpt-image-2 is exposed to the key's group. Cheaper than firing
  # a real generations request.
  - provider: sakrylle
    provider_name: Sakrylle API
    provider_url: https://sub.sakrylle.com
    service: img
    service_name: Image
    category: commercial
    sponsor: Sakrylle
    sponsor_url: https://sub.sakrylle.com
    sponsor_level: core
    key_type: official
    channel: gpt-image
    channel_name: GPT-Image
    base_url: https://api.sakrylle.com
    template: img-models-list
    interval: 90m
    env_var_name: MONITOR_SAKRYLLE_GPT_IMAGE_API_KEY
